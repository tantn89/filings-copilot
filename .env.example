# Required by SEC fair-access policy: identify yourself with a contact email.
FILINGS_SEC_USER_AGENT="filings-copilot you@example.com"
# Set to true if www.sec.gov times out while data.sec.gov works (broken IPv6 routing).
# FILINGS_SEC_FORCE_IPV4=true
# Claude credentials (or use `ant auth login`).
ANTHROPIC_API_KEY=
# Or run any model through OpenRouter instead of the Anthropic API:
# FILINGS_LLM_PROVIDER=openrouter
# FILINGS_LLM_MODEL=openai/gpt-5
# OPENROUTER_API_KEY=
# Optional overrides
# FILINGS_LLM_MODEL=claude-opus-5-5
# FILINGS_LLM_EFFORT=medium
# FILINGS_DB_PATH=data/filings.duckdb
# Public demo protection (0 = unlimited). Deploy script refuses to ship without a daily cap.
# FILINGS_DEMO_QUESTIONS_PER_HOUR=5
# FILINGS_DEMO_DAILY_QUESTION_CAP=50
# FILINGS_CORS_ORIGINS=https://your-ui.vercel.app
